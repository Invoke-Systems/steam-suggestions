PORT=3847

# Required for a public deploy. One host key; visitors only enter a Steam profile.
STEAM_API_KEY=

# Local-only fallback. Ignored automatically when STEAM_API_KEY is set.
# Set to false on a public host that is missing a key, so the UI will not ask visitors for one.
ALLOW_CLIENT_API_KEY=true

# Public origin for Steam OpenID (no trailing slash). Required in production.
# Leave empty locally so OpenID uses http://localhost:3847 from the request.
PUBLIC_URL=https://shouldiplay.co

# Store region for prices (web UI + worker). Recrawl after changing.
STEAM_CC=us
STEAM_CURRENCY=USD

# IsThereAnyDeal API key for one-time Steam historical-low backfill:
#   go run ./cmd/worker -itad-lows
ITAD_API_KEY=

# Umami / Invoke analytics (optional). When UMAMI_WEBSITE_ID is set, the tracker is injected on every page.
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=https://analytics.invoke.systems/recorder.js
UMAMI_SAMPLE_RATE=0.15
UMAMI_MASK_LEVEL=moderate
UMAMI_MAX_DURATION=300000
